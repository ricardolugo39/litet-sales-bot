# Local online/offline database selection
LITET_DB_PATH=/absolute/path/to/cache/litet.db
LITET_REPORTS_DIR=/absolute/path/to/Reports
LITET_OFFLINE_CACHE=/absolute/path/to/offline_cache/litet.db
DASHBOARD_URL=https://your-service.up.railway.app

# Railway uses a persistent volume mounted at /data.
# LITET_DB_PATH=/data/litet.db
# HASTEN_DECISION_DB=/data/litet.db

# Required before enabling report uploads.
ADMIN_UPLOAD_TOKEN=replace-with-a-long-random-secret
